{
  "id": "mr-cuentos-de-animas",
  "title": "MR · Cuentos de Ánimas",
  "description": "Sistema no oficial de Cuentos de Ánimas para Foundry VTT: Mesa de Ánimas, cartas, Espíritu, Determinación, Damas Grises y modo Dirigido con tarjetas privadas y cabina del Director. Incluye escenarios originales y 34 escenarios de distribución libre. No redistribuye el texto ni los doce escenarios del libro básico.",
  "version": "2.0.0",
  "compatibility": {
    "minimum": "13",
    "verified": "13.351",
    "maximum": "14"
  },
  "authors": [
    {
      "name": "Manu Romera",
      "url": "https://github.com/ManuRomera",
      "flags": {
        "role": "Diseño e implementación"
      }
    },
    {
      "name": "OpenAI",
      "flags": {
        "role": "Asistencia de desarrollo y diseño visual (v1.0)"
      }
    }
  ],
  "esmodules": [
    "mr-cuentos-de-animas.mjs"
  ],
  "styles": [
    "styles/system.css",
    "styles/accessibility.css"
  ],
  "languages": [
    {
      "lang": "es",
      "name": "Español",
      "path": "lang/es.json"
    },
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "protagonist": {
        "htmlFields": [
          "description",
          "backstory",
          "notes"
        ]
      }
    },
    "Item": {
      "scenario": {
        "htmlFields": [
          "publicSynopsis",
          "synopsis",
          "introduction",
          "guardianNotes"
        ]
      }
    }
  },
  "socket": true,
  "grid": {
    "distance": 1,
    "units": ""
  },
  "primaryTokenAttribute": "spirit",
  "secondaryTokenAttribute": "determination",
  "background": "systems/mr-cuentos-de-animas/assets/branding/cover.webp",
  "media": [
    {
      "type": "setup",
      "url": "systems/mr-cuentos-de-animas/assets/branding/cover.webp",
      "thumbnail": "systems/mr-cuentos-de-animas/assets/branding/logo.webp"
    },
    {
      "type": "icon",
      "url": "systems/mr-cuentos-de-animas/assets/branding/icon.svg"
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ],
      "paths": [
        "styles",
        "templates",
        "lang"
      ]
    }
  },
  "url": "https://github.com/ManuRomera/mr-cuentos-de-animas",
  "bugs": "https://github.com/ManuRomera/mr-cuentos-de-animas/issues",
  "manifest": "https://github.com/ManuRomera/mr-cuentos-de-animas/releases/latest/download/system.json",
  "download": "https://github.com/ManuRomera/mr-cuentos-de-animas/releases/latest/download/mr-cuentos-de-animas.zip",
  "readme": "https://github.com/ManuRomera/mr-cuentos-de-animas#readme",
  "changelog": "https://github.com/ManuRomera/mr-cuentos-de-animas/blob/main/CHANGELOG.md",
  "license": "LICENSE"
}
