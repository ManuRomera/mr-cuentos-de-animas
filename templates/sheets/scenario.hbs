<div class="cda-scenario-sheet">
  <header class="cda-scenario-hero">
    <img src="{{system.cover}}" data-edit="system.cover" alt="">
    <div><span class="eyebrow">{{localize "CdA.Scenario.Kicker"}}</span><input class="cda-name" name="name" value="{{item.name}}"><input name="system.hook" value="{{system.hook}}" placeholder="{{localize 'CdA.Scenario.HookPlaceholder'}}"><div class="cda-meta-row"><input name="system.author" value="{{system.author}}" placeholder="{{localize 'CdA.Scenario.Author'}}"><input name="system.duration" value="{{system.duration}}" placeholder="{{localize 'CdA.Scenario.Duration'}}"></div></div>
    <div class="cda-scenario-actions"><button type="button" data-action="play"><i class="fa-solid fa-play"></i>{{localize "CdA.Common.Play"}}</button><button type="button" data-action="export" class="subtle"><i class="fa-solid fa-file-export"></i>JSON</button></div>
  </header>
  <main class="cda-sheet-scroll cda-scenario-grid">
    <section class="cda-paper-panel wide"><header><i class="fa-solid fa-scroll"></i><h3>{{localize "CdA.Scenario.Premise"}}</h3></header><div class="cda-two"><label>{{localize "CdA.Scenario.Synopsis"}}<textarea name="system.synopsis" rows="8">{{system.synopsis}}</textarea></label><label>{{localize "CdA.Scenario.GuardianNotes"}}<textarea name="system.instructions" rows="8">{{system.instructions}}</textarea></label></div></section>

    <section class="cda-paper-panel"><header><i class="fa-solid fa-users"></i><h3>{{localize "CdA.Scenario.Characters"}}</h3><button type="button" data-action="add" data-list="secondaryCharacters"><i class="fa-solid fa-plus"></i></button></header><div class="cda-repeat-list">{{#each characters}}<article><div class="cda-repeat-head"><input name="system.secondaryCharacters.{{i}}.name" value="{{name}}"><button type="button" data-action="remove" data-list="secondaryCharacters" data-index="{{i}}"><i class="fa-solid fa-trash"></i></button></div><textarea name="system.secondaryCharacters.{{i}}.description" rows="3">{{description}}</textarea><textarea class="secret" name="system.secondaryCharacters.{{i}}.secret" rows="2" placeholder="{{localize 'CdA.Scenario.GuardianSecret'}}">{{secret}}</textarea><input type="hidden" name="system.secondaryCharacters.{{i}}.image" value="{{image}}"></article>{{/each}}</div></section>

    <section class="cda-paper-panel"><header><i class="fa-solid fa-magnifying-glass"></i><h3>{{localize "CdA.Scenario.Clues"}}</h3><button type="button" data-action="add" data-list="clues"><i class="fa-solid fa-plus"></i></button></header><div class="cda-repeat-list">{{#each clues}}<article><div class="cda-repeat-head"><input name="system.clues.{{i}}.title" value="{{title}}"><button type="button" data-action="remove" data-list="clues" data-index="{{i}}"><i class="fa-solid fa-trash"></i></button></div><textarea name="system.clues.{{i}}.text" rows="3">{{text}}</textarea><input name="system.clues.{{i}}.image" value="{{image}}" placeholder="{{localize 'CdA.Scenario.CardArt'}}"><input type="hidden" name="system.clues.{{i}}.difficulty" value="0"></article>{{/each}}</div></section>

    <section class="cda-paper-panel"><header><i class="fa-solid fa-tree"></i><h3>{{localize "CdA.Scenario.Environment"}}</h3><button type="button" data-action="add" data-list="environmentObstacles"><i class="fa-solid fa-plus"></i></button></header><div class="cda-repeat-list">{{#each env}}<article><div class="cda-repeat-head"><input name="system.environmentObstacles.{{i}}.title" value="{{title}}"><input class="difficulty" type="number" name="system.environmentObstacles.{{i}}.difficulty" value="{{difficulty}}" min="1" max="10"><button type="button" data-action="remove" data-list="environmentObstacles" data-index="{{i}}"><i class="fa-solid fa-trash"></i></button></div><textarea name="system.environmentObstacles.{{i}}.text" rows="3">{{text}}</textarea><input name="system.environmentObstacles.{{i}}.image" value="{{image}}" placeholder="{{localize 'CdA.Scenario.CardArt'}}"></article>{{/each}}</div></section>

    <section class="cda-paper-panel"><header><i class="fa-solid fa-user-lock"></i><h3>{{localize "CdA.Scenario.CharacterObstacles"}}</h3><button type="button" data-action="add" data-list="characterObstacles"><i class="fa-solid fa-plus"></i></button></header><div class="cda-repeat-list">{{#each char}}<article><div class="cda-repeat-head"><input name="system.characterObstacles.{{i}}.title" value="{{title}}"><input class="difficulty" type="number" name="system.characterObstacles.{{i}}.difficulty" value="{{difficulty}}" min="1" max="10"><button type="button" data-action="remove" data-list="characterObstacles" data-index="{{i}}"><i class="fa-solid fa-trash"></i></button></div><textarea name="system.characterObstacles.{{i}}.text" rows="3">{{text}}</textarea><input name="system.characterObstacles.{{i}}.image" value="{{image}}" placeholder="{{localize 'CdA.Scenario.CardArt'}}"></article>{{/each}}</div></section>

    <section class="cda-paper-panel"><header><i class="fa-solid fa-wand-sparkles"></i><h3>{{localize "CdA.Scenario.Incidents"}}</h3><button type="button" data-action="add" data-list="incidents"><i class="fa-solid fa-plus"></i></button></header><div class="cda-repeat-list">{{#each incidents}}<article><div class="cda-repeat-head"><input name="system.incidents.{{i}}.title" value="{{title}}"><button type="button" data-action="remove" data-list="incidents" data-index="{{i}}"><i class="fa-solid fa-trash"></i></button></div><textarea name="system.incidents.{{i}}.text" rows="3">{{text}}</textarea><input name="system.incidents.{{i}}.image" value="{{image}}" placeholder="{{localize 'CdA.Scenario.CardArt'}}"><input type="hidden" name="system.incidents.{{i}}.difficulty" value="0"></article>{{/each}}</div></section>

    <section class="cda-paper-panel cda-gray-editor"><header><i class="fa-solid fa-ghost"></i><h3>{{localize "CdA.Scenario.Gray"}}</h3></header><div class="cda-repeat-list">{{#each tension}}<article><div class="cda-repeat-head"><span class="roman">{{i}}</span><input name="system.tension.{{i}}.title" value="{{title}}"></div><textarea name="system.tension.{{i}}.text" rows="4">{{text}}</textarea></article>{{/each}}</div></section>

    <section class="cda-paper-panel"><header><i class="fa-solid fa-cloud-moon"></i><h3>{{localize "CdA.Scenario.MemoryQuestions"}}</h3><button type="button" data-action="add" data-list="memories"><i class="fa-solid fa-plus"></i></button></header><div class="cda-repeat-list">{{#each memories}}<article><div class="cda-repeat-head"><input name="system.memories.{{i}}.title" value="{{title}}"><button type="button" data-action="remove" data-list="memories" data-index="{{i}}"><i class="fa-solid fa-trash"></i></button></div><textarea name="system.memories.{{i}}.prompt" rows="2">{{prompt}}</textarea><textarea name="system.memories.{{i}}.followUp" rows="2" placeholder="{{localize 'CdA.Scenario.FollowUp'}}">{{followUp}}</textarea></article>{{/each}}</div></section>

    <section class="cda-paper-panel wide"><header><i class="fa-solid fa-palette"></i><h3>{{localize "CdA.Scenario.Art"}}</h3></header><div class="cda-two"><label>{{localize "CdA.Scenario.Cover"}}<input name="system.cover" value="{{system.cover}}" placeholder="systems/.../cover.webp"></label><label>{{localize "CdA.Scenario.Back"}}<input name="system.customBack" value="{{system.customBack}}" placeholder="Vacío = reverso del sistema"></label></div><p class="hint">{{localize "CdA.Scenario.ArtHint"}}</p></section>

    <section class="cda-paper-panel wide"><header><i class="fa-solid fa-door-open"></i><h3>{{localize "CdA.Scenario.Epilogues"}}</h3></header><div class="cda-epilogues"><label><strong>2 o más</strong><textarea name="system.epilogues.high" rows="4">{{system.epilogues.high}}</textarea></label><label><strong>1</strong><textarea name="system.epilogues.low" rows="4">{{system.epilogues.low}}</textarea></label><label><strong>0</strong><textarea name="system.epilogues.zero" rows="4">{{system.epilogues.zero}}</textarea></label></div></section>
  </main>
</div>
