<div class="cda-protagonist-sheet">
  <header class="cda-sheet-hero">
    <img class="cda-portrait" src="{{actor.img}}" data-edit="img" alt="{{actor.name}}">
    <div class="cda-identity">
      <span class="eyebrow">{{localize "CdA.Actor.Kicker"}}</span>
      <input class="cda-name" name="name" value="{{actor.name}}" placeholder="{{localize 'CdA.Actor.Name'}}">
      <div class="cda-identity-row"><input name="system.profession" value="{{system.profession}}" placeholder="{{localize 'CdA.Actor.Profession'}}"><input name="system.origin" value="{{system.origin}}" placeholder="{{localize 'CdA.Actor.Origin'}}"></div>
    </div>
    <div class="cda-sheet-shortcuts"><button type="button" data-action="diary" data-mr-help="diary"><i class="fa-solid fa-book-open"></i><span>{{diaryCount}}</span></button><button type="button" data-action="truths" data-mr-help="truth"><i class="fa-solid fa-eye"></i><span>{{truthCount}}</span></button></div>
  </header>
  <div class="cda-resource-ribbon">
    <section class="cda-resource spirit" data-mr-help="spirit"><div><span>{{localize "CdA.Table.Spirit"}}</span><strong>{{system.spirit.value}} / {{system.spirit.max}}</strong></div><div class="cda-resource-gems">{{#each spirit}}<button type="button" data-action="resource" data-resource="spirit" data-n="{{n}}"><img src="systems/mr-cuentos-de-animas/assets/counters/{{#if on}}spirit-on{{else}}spirit-off{{/if}}.svg" alt="{{n}}"></button>{{/each}}</div></section>
    <div class="cda-resource-divider"><i class="fa-solid fa-moon"></i></div>
    <section class="cda-resource determination" data-mr-help="determination"><div><span>{{localize "CdA.Table.Determination"}}</span><strong>{{system.determination.value}} / {{system.determination.max}}</strong></div><div class="cda-resource-gems">{{#each determination}}<button type="button" data-action="resource" data-resource="determination" data-n="{{n}}"><img src="systems/mr-cuentos-de-animas/assets/counters/{{#if on}}determination-on{{else}}determination-off{{/if}}.svg" alt="{{n}}"></button>{{/each}}</div></section>
  </div>
  <main class="cda-sheet-scroll">
    <div class="cda-sheet-columns">
      <section class="cda-paper-panel"><header><i class="fa-solid fa-feather"></i><h3>{{localize "CdA.Actor.Who"}}</h3></header><label>{{localize "CdA.Actor.Description"}}<textarea name="system.physicalDescription" rows="5">{{system.physicalDescription}}</textarea></label><label>{{localize "CdA.Actor.History"}}<textarea name="system.backstory" rows="8">{{system.backstory}}</textarea></label></section>
      <section class="cda-paper-panel"><header><i class="fa-solid fa-shapes"></i><h3>{{localize "CdA.Actor.Defines"}}</h3><button type="button" data-action="add" data-list="traits"><i class="fa-solid fa-plus"></i></button></header><div class="cda-repeat-list">{{#each traits}}<article><div class="cda-repeat-head"><i class="{{icon}}"></i><input name="system.traits.{{i}}.label" value="{{label}}"><button type="button" data-action="remove" data-list="traits" data-index="{{i}}"><i class="fa-solid fa-trash"></i></button></div><textarea name="system.traits.{{i}}.text" rows="2">{{text}}</textarea><input type="hidden" name="system.traits.{{i}}.icon" value="{{icon}}"></article>{{/each}}</div></section>
      <section class="cda-paper-panel"><header><i class="fa-solid fa-key"></i><h3>{{localize "CdA.Actor.Objects"}}</h3><button type="button" data-action="add" data-list="objects"><i class="fa-solid fa-plus"></i></button></header><div class="cda-repeat-list">{{#each objects}}<article><div class="cda-repeat-head"><input name="system.objects.{{i}}.label" value="{{label}}"><button type="button" data-action="remove" data-list="objects" data-index="{{i}}"><i class="fa-solid fa-trash"></i></button></div><textarea name="system.objects.{{i}}.text" rows="2">{{text}}</textarea><input name="system.objects.{{i}}.image" value="{{image}}" placeholder="{{localize 'CdA.Actor.OptionalImage'}}"></article>{{/each}}</div></section>
      <section class="cda-paper-panel"><header><i class="fa-solid fa-cloud-moon"></i><h3>{{localize "CdA.Actor.Memories"}}</h3><button type="button" data-action="add" data-list="memories"><i class="fa-solid fa-plus"></i></button></header><div class="cda-repeat-list">{{#each memories}}<article><div class="cda-repeat-head"><input name="system.memories.{{i}}.title" value="{{title}}"><button type="button" data-action="remove" data-list="memories" data-index="{{i}}"><i class="fa-solid fa-trash"></i></button></div><textarea name="system.memories.{{i}}.text" rows="3">{{text}}</textarea><label class="cda-inline-check"><input type="checkbox" name="system.memories.{{i}}.revealed" {{checked revealed}}> {{localize "CdA.Actor.Revealed"}}</label></article>{{/each}}</div></section>
    </div>
    <section class="cda-paper-panel cda-notes"><header><i class="fa-solid fa-pen-nib"></i><h3>{{localize "CdA.Common.Notes"}}</h3></header><textarea name="system.notes" rows="5">{{system.notes}}</textarea></section>
  </main>
</div>
