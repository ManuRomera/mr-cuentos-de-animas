<div class="cda-welcome">
  <img class="cda-welcome-art" src="systems/mr-cuentos-de-animas/assets/branding/cover.webp" alt="">
  <p><strong>{{localize "CdA.Welcome.Ready"}}</strong> {{localize "CdA.Welcome.Body"}}</p>
  <div class="cda-welcome-grid">
    <button type="button" class="cda-primary" data-action="go" data-app="table"><i class="fa-solid fa-fire-flame-curved" aria-hidden="true"></i>{{localize "CdA.Welcome.Table"}}</button>
    <button type="button" data-action="go" data-app="start"><i class="fa-solid fa-book" aria-hidden="true"></i>{{localize "CdA.Welcome.New"}}</button>
    <button type="button" data-action="go" data-app="protagonist"><i class="fa-solid fa-user-plus" aria-hidden="true"></i>{{localize "CdA.Welcome.Protagonist"}}</button>
    <button type="button" data-action="go" data-app="random"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i>{{localize "CdA.Create.Random"}}</button>
    <button type="button" data-action="go" data-app="library"><i class="fa-solid fa-book-open" aria-hidden="true"></i>{{localize "CdA.Welcome.Library"}}</button>
  </div>
  <button type="button" class="cda-link" data-action="hide">{{localize "CdA.Welcome.Hide"}}</button>
</div>
