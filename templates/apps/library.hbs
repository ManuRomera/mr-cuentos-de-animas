<div class="cda-library-body">
  <header class="cda-library-hero"><div><span>{{localize "CdA.Library.Kicker"}}</span><h2>{{localize "CdA.Library.Title"}}</h2></div>{{#if isGM}}<div class="cda-library-actions"><button type="button" data-action="import"><i class="fa-solid fa-file-import"></i>{{localize "CdA.Library.Import"}}</button><button type="button" data-action="create"><i class="fa-solid fa-plus"></i>{{localize "CdA.Library.Create"}}</button></div>{{/if}}</header>
  <div class="cda-library-grid">{{#each scenarios}}<article class="cda-book-card"><div class="cda-book-cover"><img src="{{img}}" alt=""><span>{{duration}}</span></div><div class="cda-book-copy"><small>{{tone}}</small><h3>{{name}}</h3><p>{{hook}}</p><div><button type="button" data-action="play" data-uuid="{{uuid}}"><i class="fa-solid fa-play"></i>{{localize "CdA.Common.Play"}}</button><button type="button" class="subtle" data-action="open" data-uuid="{{uuid}}"><i class="fa-solid fa-feather"></i>{{localize "CdA.Common.Edit"}}</button></div></div></article>{{/each}}</div>
</div>
