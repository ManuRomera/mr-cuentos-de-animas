<div class="cda-import-help">
  <div class="cda-help-scroll">
    <p class="cda-lede">{{localize "CdA.ImportHelp.Intro"}}</p>

    <h3 class="cda-section-title">1 · {{localize "CdA.ImportHelp.FileTitle"}}</h3>
    <ul class="cda-bullets">
      <li>{{localize "CdA.ImportHelp.File1"}}</li>
      <li>{{localize "CdA.ImportHelp.File2"}}</li>
      <li>{{localize "CdA.ImportHelp.File3"}}</li>
      <li>{{localize "CdA.ImportHelp.File4"}}</li>
    </ul>

    <h3 class="cda-section-title">2 · {{localize "CdA.ImportHelp.FieldsTitle"}}</h3>
    <table class="cda-fields-table">
      <thead><tr><th>{{localize "CdA.ImportHelp.Key"}}</th><th></th><th>{{localize "CdA.ImportHelp.What"}}</th></tr></thead>
      <tbody>{{#each fields}}<tr><td><code>{{key}}</code></td><td>{{#if required}}<span class="cda-tag mode">{{localize "CdA.ImportHelp.Required"}}</span>{{/if}}</td><td>{{text}}</td></tr>{{/each}}</tbody>
    </table>
    <p class="cda-note">{{localize "CdA.ImportHelp.Values"}} <b>modes</b>: {{#each modes}}<code>{{key}}</code> ({{label}}){{#unless @last}}, {{/unless}}{{/each}}. <b>tags</b>: {{#each tags}}<code>{{key}}</code> ({{label}}){{#unless @last}}, {{/unless}}{{/each}}.</p>

    <h3 class="cda-section-title">3 · {{localize "CdA.ImportHelp.TemplateTitle"}}</h3>
    <pre class="cda-code">{{template}}</pre>

    <h3 class="cda-section-title">4 · {{localize "CdA.ImportHelp.PromptTitle"}}</h3>
    <p>{{localize "CdA.ImportHelp.PromptIntro"}}</p>
    <textarea class="cda-prompt" readonly rows="10" aria-label="{{localize 'CdA.ImportHelp.PromptTitle'}}">{{prompt}}</textarea>

    <h3 class="cda-section-title">5 · {{localize "CdA.ImportHelp.ErrorsTitle"}}</h3>
    <p>{{localize "CdA.ImportHelp.Errors"}}</p>
  </div>
  <footer class="cda-row-end">
    <button type="button" data-action="template"><i class="fa-solid fa-download" aria-hidden="true"></i>{{localize "CdA.ImportHelp.Download"}}</button>
    <button type="button" class="cda-primary" data-action="copy"><i class="fa-regular fa-copy" aria-hidden="true"></i>{{localize "CdA.ImportHelp.CopyPrompt"}}</button>
  </footer>
</div>
