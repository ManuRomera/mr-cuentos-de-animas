<div class="cda-safety-panel">
  <p class="cda-lede">{{localize "CdA.Safety.Intro"}}</p>
  <button type="button" class="cda-safety-btn pause" data-action="signal" data-signal="pause"><i class="fa-solid fa-pause" aria-hidden="true"></i><span><strong>{{localize "CdA.Safety.Pause"}}</strong><small>{{localize "CdA.Safety.PauseHint"}}</small></span></button>
  <button type="button" class="cda-safety-btn veil" data-action="signal" data-signal="veil"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i><span><strong>{{localize "CdA.Safety.Veil"}}</strong><small>{{localize "CdA.Safety.VeilHint"}}</small></span></button>
  <button type="button" class="cda-safety-btn x" data-action="signal" data-signal="x"><i class="fa-solid fa-xmark" aria-hidden="true"></i><span><strong>{{localize "CdA.Safety.X"}}</strong><small>{{localize "CdA.Safety.XHint"}}</small></span></button>
  <p class="cda-note"><i class="fa-solid fa-user-secret" aria-hidden="true"></i>{{localize "CdA.Safety.Anonymous"}}</p>
</div>
