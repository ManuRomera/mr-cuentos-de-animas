<div class="cda-truth-body"><header><div><span>{{localize "CdA.Truth.Kicker"}}</span><h2>{{localize "CdA.Truth.Title"}}</h2></div><button type="button" data-action="add"><i class="fa-solid fa-plus"></i>{{localize "CdA.Truth.Add"}}</button></header><p class="intro">{{localize "CdA.Truth.Intro"}}</p><div class="cda-truth-list">{{#each truths}}<article class="status-{{status}}"><button type="button" class="cda-truth-seal" data-action="status" data-index="{{i}}"><i class="fa-solid {{#if established}}fa-check{{else if questioned}}fa-question{{else}}fa-bolt{{/if}}"></i></button><div><p>{{text}}</p>{{#if source}}<small>{{source}}</small>{{/if}}</div><button type="button" class="delete" data-action="remove" data-index="{{i}}"><i class="fa-solid fa-trash"></i></button></article>{{else}}<div class="cda-empty-state"><i class="fa-solid fa-eye-slash"></i><p>{{localize "CdA.Truth.Empty"}}</p></div>{{/each}}</div></div>
