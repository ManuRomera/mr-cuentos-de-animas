<div class="cda-diary-body"><header><div><span>{{localize "CdA.Diary.Kicker"}}</span><h2>{{actor.name}}</h2></div><div><button type="button" data-action="add"><i class="fa-solid fa-plus"></i>{{localize "CdA.Diary.Add"}}</button><button type="button" data-action="export"><i class="fa-solid fa-file-arrow-down"></i>Markdown</button></div></header><div class="cda-diary-list">{{#each entries}}<article><div class="cda-diary-meta"><span>{{date}}</span><strong>{{title}}</strong><button type="button" data-action="remove" data-index="{{i}}"><i class="fa-solid fa-trash"></i></button></div><textarea data-entry="{{i}}" rows="5">{{text}}</textarea></article>{{else}}<div class="cda-empty-state"><i class="fa-solid fa-feather-pointed"></i><p>{{localize "CdA.Diary.Empty"}}</p></div>{{/each}}</div></div>
