{{!-- Carta física. Estilo fotográfico: arte + marco + tipo + dificultad. Estilo clásico: la carta oficial tal cual. --}}
<div class="cda-card kind-{{card.kind}} {{size}} {{#if card.classic}}skin-classic{{/if}}" data-card-id="{{card.id}}" data-help="card-{{card.kind}}"
  aria-label="{{card.kindLabel}}{{#if card.value}} {{card.value}}{{/if}}{{#if card.gray}} {{card.gray}}{{/if}}{{#if card.scene}}: {{card.scene.title}}{{/if}}">
  <div class="cda-card-inner">
    <div class="cda-card-face cda-card-front">
      <img class="cda-card-art" src="{{card.img}}" alt="" decoding="async">
      {{#unless card.classic}}
      <div class="cda-card-frame" aria-hidden="true"></div>
      <span class="cda-card-kind"><i class="{{card.icon}}" aria-hidden="true"></i>{{card.kindLabel}}{{#if card.gray}} {{card.gray}}{{/if}}</span>
      {{#if card.value}}<span class="cda-card-seal" title="{{localize 'CdA.Game.Difficulty'}}"><small>{{localize "CdA.Game.DifficultyShort"}}</small>{{card.value}}</span>{{/if}}
      {{/unless}}
    </div>
    <div class="cda-card-face cda-card-back" aria-hidden="true"><img src="{{card.back}}" alt=""></div>
  </div>
</div>
